{
  "type": "voxel",
  "id": "oak",
  "solid": true,
  "hardness": 4,

  // Tarred timber, near-black. Sits at the dark end so a timber frame reads
  // against pale infill and thatch at camera distance (palette contrast rule).
  "value": 12,
  "hue": 28,
  "saturation": 30,
  "class": "timber",

  // S11: voxels a tick of labour brings in when the land within hauling
  // range offers it in full; fewer source columns, proportionally less. A
  // voxel is an eighth of a cubic metre, a tick a quarter of a day, so 1.5
  // is roughly what one person fells, trims and carries.
  "gather": { "perLabourTick": 1.5 }
}
