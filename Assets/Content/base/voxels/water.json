{
  "type": "voxel",
  "id": "water",
  "solid": false,
  "hardness": 0,

  // Bright enough to separate from every shoreline material it touches.
  // `value` is perceived lightness 0-100. The palette's contrast rule is
  // checked against it, because two materials that read as the same value at
  // camera distance are one material as far as the player is concerned.
  "value": 61,
  // Hue and saturation are presentation; lightness is `value` above, so the
  // contrast rule and the rendered colour cannot disagree about it.
  "hue": 204,
  "saturation": 58,
  "class": "water"
}
