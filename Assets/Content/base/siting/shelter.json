{
  "type": "siting",
  "id": "shelter",
  "for": "shelter",
  "tell": "A culture that builds high takes the dry ridge and a culture that builds low takes the sheltered hollow by the water, out of the same ground.",

  // S15. Which ground a culture calls good is content, in the grammar's
  // expression language. Fields run 0..1 (S1F); parcel.slope is voxels of
  // rise across the parcel, parcel.water and parcel.hearth are in parcels.
  "searchRadiusParcels": 20,

  // S2O. Once the ground is scored, how the house sits on it. Each is a
  // weight, in the same language, over the genome: the dwelling program tries
  // every way round on the best few sites and adds these up. A communal
  // culture turns its doors to the fire; one that lets the light in turns
  // them to the sun; a culture that keeps low backs its houses into the
  // hillside so the slope is the back wall; everyone would rather step out
  // downhill than climb out of their own door.
  "prefer": {
    "doorToFire": "lerp(0.2, 1.4, gene.communal_ratio)",
    "doorToSun": "lerp(0.1, 0.9, gene.aperture_ratio)",
    "doorDownhill": "0.6",
    "backIntoSlope": "lerp(1.2, 0.0, gene.elevation_bias)",
    "nearKin": "lerp(0.02, 0.2, gene.communal_ratio)",

    // S2I. A family that works a farm would rather live by its fields; a
    // communal culture minds the walk less than it minds leaving the fire.
    "nearWork": "lerp(0.2, 0.06, gene.communal_ratio)",

    // S2P. What a crowded family would rather do than move out: add a wing
    // beside the house, add a storey on top of it, or build again apart.
    "wing": "lerp(0.4, 1.4, gene.communal_ratio)",
    "storey": "lerp(-0.4, 1.6, gene.verticality)",
    "apart": "lerp(0.9, 0.0, gene.communal_ratio)"
  },

  // Hard requirements: dry land, not a bog, and not a cliff.
  "allow": "parcel.land * (parcel.wet < 5) * (parcel.slope < 10)",

  // Flat ground is worth something but not everything: since S16 a
  // settlement can terrace or stilt, so the flattest parcel on the island is
  // no longer worth crossing it for. Weighting it heavily made every culture
  // choose the same site.
  //
  // Everything else is a preference, and the genome sets how much each
  // weighs. Flat ground and water within reach matter to everyone; who
  // fears the flood, who wants the light and who keeps close to the others
  // is the culture's own business.
  "score": "1.0 * (1 - clamp(parcel.slope, 0, 8) / 8) + lerp(0.2, 3.0, gene.elevation_bias) * (1 - field.flood) + lerp(0.1, 1.2, gene.elevation_bias) * field.exposure + lerp(0.1, 1.0, gene.aperture_ratio) * field.sun + lerp(0.1, 1.5, 1 - gene.roof_pitch) * (1 - field.snow) + 0.8 * (1 - field.damp) - 0.35 * clamp(parcel.water - 3, 0, 12) - lerp(0.1, 0.8, gene.communal_ratio) * parcel.hearth"
}
