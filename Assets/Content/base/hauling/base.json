{
  "type": "hauling",
  "id": "base",
  "tell": "Stacks of logs lie by the stumps and stones by the boulders, sheaves in the stubble, and people walk between them and the yard with their arms full.",

  // S2X. What one person carries at a time: a few half-metre blocks of wood
  // or stone, or a sack of a dozen meals.
  "loadVoxels": 4,
  "loadMeals": 12,

  // Part of a tick spent lifting a load and setting it down. With the walk,
  // this is how many loads fit in a tick: a heap by the fire goes in twenty
  // loads, one at the edge of the woods in ten.
  "handlingTicks": 0.05,

  // S2H. With no store, the larder by the fire takes in about a fortnight of
  // harvest a person. A field's harvest is more than that: the rest waits in
  // the field, going grey, until there is a store to carry it to. Foraged
  // food is eaten as it comes and never waits for room.
  "larderMealsPerPerson": 15,

  // How a heap is drawn as it grows, in loads.
  "heaps": [
    { "fromLoads": 0.01, "food": "heap-sacks-small", "material": "heap-stack-small" },
    { "fromLoads": 6, "food": "heap-sacks-large", "material": "heap-stack-large" }
  ]
}
