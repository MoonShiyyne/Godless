{
  "type": "households",
  "id": "base",
  "tell": "Families live together and a crowded family builds on; a village that eats well has more children the bigger it gets, and a family too large for one hearth splits and puts up a house of its own nearby.",

  // S2N. Expressions in the grammar's language, over the genome. A communal
  // culture keeps big households under one roof; a private one, small ones.
  "size": "round(lerp(4, 9, gene.communal_ratio))",
  "splitsAbove": "round(lerp(7, 16, gene.communal_ratio))",

  // Children a year per person, when everyone is fed, housed and there is
  // food put by: about three in ten, so a village of twenty adds six a year
  // and one of a hundred adds thirty. Growth is what speeds up, not the rate.
  "birthsPerPersonYear": 0.30,

  // A crowded settlement still has children, fewer of them: fertility falls
  // with the share of people who have a bed, down to this floor.
  "crowdedFertility": 0.3,

  // Deaths a year per person from everything that is not hunger.
  "deathsPerPersonYear": 0.015
}
