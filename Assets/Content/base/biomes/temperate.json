{
  "type": "biome",
  "id": "temperate",

  // Part 05: bind the palette to the biome. The same genome in two biomes
  // must produce two visibly different cities, and that is nearly free once
  // the stock system exists.
  "materials": ["oak", "thatch"],
  "rainfallMm": 800,
  "winterSeverity": 2,
  "treeCoverPercent": 55,

  "surface": "soil",
  "subsurface": "granite",

  // Worldgen picks the first biome, in id order, whose window contains the
  // column. Windows may overlap; the ordering makes the choice deterministic.
  "select": { "minElevation": 46, "maxElevation": 70, "minMoisture": 35, "maxMoisture": 101 }
}
