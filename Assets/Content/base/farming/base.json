{
  "type": "farming",
  "id": "base",
  "tell": "Squares of brown furrows lie away from the houses, turning green, then gold, then stubble, and grow a plot or two at a time while there are hungry mouths and free hands.",

  // S2I. A first farm is looked for this far round the fire, in parcels.
  "searchRadiusParcels": 24,

  // Fields keep this many clear parcels from any house, store or the fire:
  // the village does not plough its own doorsteps.
  "awayFromHouses": 2,

  // Flat enough to plough, and not a pond.
  "maxSlope": 3,
  "maxWetColumns": 4,

  // Ground poorer than this for the farm's crop is left alone.
  "minSuitability": 0.3,

  "firstPlots": 8,
  "fewestPlots": 3,

  // Every so many days a farm weighs growing: by this many plots, to at most
  // this many. A plot feeds about half a person over a year, so a farm that
  // lifts a village past what the land gives is dozens of plots — and a farm
  // hemmed in with food still short is the reason for the next one.
  "growEveryDays": 10,
  "plotsPerGrowth": 3,
  "mostPlots": 60,

  // One pair of hands keeps up with about a dozen plots through a round; no
  // more than this share of a settlement takes to the fields.
  "plotsPerHand": 12,
  "handsShare": 0.6,

  // A plot kept waiting this many days for sowing or harvest says the farm is
  // short of hands; a ripe crop left past it sheds a share a day.
  "waitDays": 6,
  "shedPerDay": 0.02,

  // Resting soil comes back a little every day.
  "restorePerDay": 0.004,

  "tilledVoxel": "voxel.tilled"
}
