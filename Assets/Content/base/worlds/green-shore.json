  "water":  { "riverFlow": 2400, "maxLakeDepth": 3 },

  // How much of the map this world should be land. The harness checks
  // every seed against this, so a generator change that quietly drowns or
  // floods a map is caught at 200 seeds rather than by eye.
  //
  // Over seeds 0-199 it is 5.9% to 23.6% land; seed 164 is the low one.
  "land": { "least": 0.05, "most": 0.3 },

  "centres": [ { "x": 0.5, "z": 0.5, "radius": 0.46 } ],
  "biomes": ["shore", "temperate", "highland", "alpine", "flood-plain"]
