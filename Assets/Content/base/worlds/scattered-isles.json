{
  "type": "world",
  "id": "scattered-isles",
  "title": "The Scattered Isles",

  // Five small islands, none of them tall, all of them coast. There is oak
  // and thatch enough on the larger ones, mud and reed at the waterline, and
  // a single hill of stone on one island for everybody to argue over.
  "tell": "Five small islands in open water, none more than a short walk across. Oak inland, reed at the edges, and one hill of stone on one island.",

  "seaLevel": 42,
  "height": { "base": 20, "relief": 72, "linear": 0.58, "cubic": 0.42, "peak": 0.9, "step": 0 },
  "noise":  { "continentScale": 140, "roughScale": 38, "roughWeight": 0.34, "moistureScale": 150, "moistureBias": 0.18 },
  "water":  { "riverFlow": 3600, "maxLakeDepth": 2 },

  // How much of the map this world should be land. The harness checks
  // every seed against this, so a generator change that quietly drowns or
  // floods a map is caught at 200 seeds rather than by eye.
  "land": { "least": 0.02, "most": 0.14 },

  "centres": [
    { "x": 0.30, "z": 0.28, "radius": 0.16 },
    { "x": 0.68, "z": 0.24, "radius": 0.13 },
    { "x": 0.50, "z": 0.52, "radius": 0.14 },
    { "x": 0.26, "z": 0.74, "radius": 0.18 },
    { "x": 0.74, "z": 0.70, "radius": 0.15 }
  ],
  // No flood plain: an island this small has no river long enough to
  // build one, so there is no mud here and roofs are reed or thatch.
  "biomes": ["shore", "temperate", "highland"]
}
