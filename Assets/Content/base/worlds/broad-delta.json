{
  "type": "world",
  "id": "broad-delta",
  "title": "The Broad Delta",

  // Wet, flat and low: two overlapping lobes of silt with barely any rise in
  // them. Water cuts channels at a third of the usual flow, so the map is
  // more river than land, and the only building materials are mud and reed.
  "tell": "Flat wet country cut into islands by its own rivers. Mud walls, reed roofs, and the water is never more than a field away.",

  "seaLevel": 44,
  "height": { "base": 30, "relief": 34, "linear": 0.86, "cubic": 0.14, "peak": 0.6, "step": 0 },
  "noise":  { "continentScale": 190, "roughScale": 70, "roughWeight": 0.14, "moistureScale": 210, "moistureBias": 0.34 },
  "water":  { "riverFlow": 900, "maxLakeDepth": 2 },

  // How much of the map this world should be land. The harness checks
  // every seed against this, so a generator change that quietly drowns or
  // floods a map is caught at 200 seeds rather than by eye.
  "land": { "least": 0.008, "most": 0.16 },

  "centres": [
    { "x": 0.42, "z": 0.46, "radius": 0.40 },
    { "x": 0.62, "z": 0.58, "radius": 0.34 }
  ],
  "biomes": ["shore", "flood-plain", "temperate"]
}
