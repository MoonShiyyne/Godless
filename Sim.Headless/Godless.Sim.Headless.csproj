<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless runner. This is what buys unattended iteration: a thousand
       simulated years in seconds with no Editor, no GPU and no Unity licence
       in the loop. Registry S08. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Godless.Sim.Headless</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>sim</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Godless.Sim.csproj" />
  </ItemGroup>

</Project>
